{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "browser",
  "description": "Built-in browser overlay (floating button and format sheet) in the main window. The visited page (browser-page) is a remote origin and matches no capability.",
  "webviews": ["browser-overlay"],
  "permissions": [
    "core:event:default",
    "allow-browser-state",
    "allow-browser-sheet",
    "allow-browser-fab-size",
    "allow-browser-show-in-app",
    "allow-validate-media-url",
    "allow-analyze-link",
    "allow-components-status",
    "allow-components-install",
    "allow-downloads-list",
    "allow-history-list",
    "allow-downloads-start",
    "allow-settings-get",
    "allow-settings-pick-download-dir"
  ]
}
