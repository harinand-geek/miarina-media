{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least-privilege permissions for the main window. Only the application's own validated commands are allowed; no filesystem, shell, dialog or opener permission is exposed to the frontend.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "allow-validate-media-url",
    "allow-analyze-link",
    "allow-downloads-list",
    "allow-downloads-start",
    "allow-downloads-pause",
    "allow-downloads-resume",
    "allow-downloads-cancel",
    "allow-downloads-retry",
    "allow-downloads-start-now",
    "allow-downloads-move",
    "allow-downloads-pause-all",
    "allow-downloads-resume-all",
    "allow-downloads-reveal",
    "allow-history-list",
    "allow-history-clear",
    "allow-history-reveal",
    "allow-settings-get",
    "allow-settings-set-concurrency",
    "allow-settings-set-resource-mode",
    "allow-settings-pick-download-dir",
    "allow-components-status",
    "allow-components-install"
  ]
}
