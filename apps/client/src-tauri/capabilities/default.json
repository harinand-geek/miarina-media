{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least-privilege permissions for the main window (its own webview; the browser page in it is a remote origin and matches no capability). Only the application's own validated commands are allowed; no filesystem, shell, dialog or opener permission is exposed to the frontend.",
  "windows": ["main"],
  "permissions": [
    "allow-app-update-progress", "allow-app-update-check", "allow-app-update-download", "allow-app-update-install",
    "allow-browser-inbox",
    "allow-browser-inbox-dismiss",
    "allow-browser-bridge-register",
    "allow-browser-extension-folder",
    "allow-torrents-enable",
    "allow-torrents-disable",
    "allow-torrents-list",
    "allow-torrents-preview",
    "allow-torrents-start",
    "allow-torrents-action",
    "allow-torrents-limits",
    "core:event:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "allow-validate-media-url",
    "allow-analyze-link",
    "allow-downloads-list",
    "allow-downloads-start",
    "allow-downloads-pause",
    "allow-downloads-resume",
    "allow-downloads-cancel",
    "allow-downloads-retry",
    "allow-downloads-start-now",
    "allow-downloads-move",
    "allow-downloads-pause-all",
    "allow-downloads-resume-all",
    "allow-downloads-reveal",
    "allow-history-list",
    "allow-history-clear",
    "allow-history-reveal",
    "allow-settings-get",
    "allow-settings-set-concurrency",
    "allow-settings-set-resource-mode",
    "allow-settings-pick-download-dir",
    "allow-components-status",
    "allow-components-install",
    "allow-components-update-ytdlp",
    "allow-library-query",
    "allow-library-overview",
    "allow-library-get",
    "allow-library-rename",
    "allow-library-tags",
    "allow-library-update-tags",
    "allow-library-groups",
    "allow-library-remove",
    "allow-library-delete",
    "allow-library-reveal",
    "allow-library-rescan",
    "allow-storage-usage",
    "allow-storage-clear-thumbnails",
    "allow-storage-clean-temp",
    "allow-library-open-external",
    "allow-library-share",
    "allow-downloads-open-folder",
    "allow-browser-open",
    "allow-browser-navigate",
    "allow-browser-nav",
    "allow-browser-state",
    "allow-browser-sheet",
    "allow-browser-frame",
    "allow-browser-favorites",
    "allow-browser-favorite-toggle",
    "allow-player-open",
    "allow-player-queue",
    "allow-player-skip",
    "allow-player-repeat",
    "allow-player-status",
    "allow-player-play",
    "allow-player-pause",
    "allow-player-seek",
    "allow-player-rate",
    "allow-player-surface",
    "allow-player-close",
    "allow-app-ready",
    "allow-app-take-launch",
    "allow-app-read-clipboard",
    "core:app:allow-register-listener",
    "core:app:allow-remove-listener"
  ]
}
