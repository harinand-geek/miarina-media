<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ splash animation (design_handoff_splash S6), 1000 ms:
     tile visible at 0; teal bars slide in (translateX -5 -> 0, glyph units)
     and fade in, 400 ms each, starting at 0 / 100 / 200 ms (top, middle,
     bottom); coral play scales 0.6 -> 1 around its centre and fades in,
     600 ms from 400 ms. Easing: standard cubic-bezier(.2, 0, 0, 1).
     With system animations off, Android shows the final frame. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="240dp"
            android:height="240dp"
            android:viewportWidth="240"
            android:viewportHeight="240">
            <group android:translateX="64" android:translateY="64" android:scaleX="3.5" android:scaleY="3.5">
                <path android:fillColor="#FF182530" android:pathData="M8,0h16a8,8 0,0 1,8 8v16a8,8 0,0 1,-8 8h-16a8,8 0,0 1,-8 -8v-16a8,8 0,0 1,8 -8z"/>
                <group android:name="bar1" android:translateX="-5">
                    <path android:name="bar1_fill" android:fillColor="#FF35C9BD" android:fillAlpha="0" android:pathData="M7.25,10.5h1.5a1.25,1.25 0,0 1,0 2.5h-1.5a1.25,1.25 0,0 1,0 -2.5z"/>
                </group>
                <group android:name="bar2" android:translateX="-5">
                    <path android:name="bar2_fill" android:fillColor="#FF35C9BD" android:fillAlpha="0" android:pathData="M5.25,14.75h3.5a1.25,1.25 0,0 1,0 2.5h-3.5a1.25,1.25 0,0 1,0 -2.5z"/>
                </group>
                <group android:name="bar3" android:translateX="-5">
                    <path android:name="bar3_fill" android:fillColor="#FF35C9BD" android:fillAlpha="0" android:pathData="M7.25,19h1.5a1.25,1.25 0,0 1,0 2.5h-1.5a1.25,1.25 0,0 1,0 -2.5z"/>
                </group>
                <!-- Pivot: centre of the triangle (13,9.5) (13,22.5) (23,16). -->
                <group android:name="play" android:pivotX="16.333" android:pivotY="16" android:scaleX="0.6" android:scaleY="0.6">
                    <path android:name="play_fill" android:fillColor="#FFFF7A45" android:fillAlpha="0" android:pathData="M13,9.5v13l10,-6.5z"/>
                </group>
            </group>
        </vector>
    </aapt:attr>

    <target android:name="bar1">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="translateX" android:valueFrom="-5" android:valueTo="0" android:valueType="floatType" android:duration="400" android:startOffset="0" android:interpolator="@interpolator/mm_standard"/>
        </aapt:attr>
    </target>
    <target android:name="bar1_fill">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="fillAlpha" android:valueFrom="0" android:valueTo="1" android:valueType="floatType" android:duration="400" android:startOffset="0" android:interpolator="@interpolator/mm_standard"/>
        </aapt:attr>
    </target>
    <target android:name="bar2">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="translateX" android:valueFrom="-5" android:valueTo="0" android:valueType="floatType" android:duration="400" android:startOffset="100" android:interpolator="@interpolator/mm_standard"/>
        </aapt:attr>
    </target>
    <target android:name="bar2_fill">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="fillAlpha" android:valueFrom="0" android:valueTo="1" android:valueType="floatType" android:duration="400" android:startOffset="100" android:interpolator="@interpolator/mm_standard"/>
        </aapt:attr>
    </target>
    <target android:name="bar3">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="translateX" android:valueFrom="-5" android:valueTo="0" android:valueType="floatType" android:duration="400" android:startOffset="200" android:interpolator="@interpolator/mm_standard"/>
        </aapt:attr>
    </target>
    <target android:name="bar3_fill">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="fillAlpha" android:valueFrom="0" android:valueTo="1" android:valueType="floatType" android:duration="400" android:startOffset="200" android:interpolator="@interpolator/mm_standard"/>
        </aapt:attr>
    </target>
    <target android:name="play">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX" android:valueFrom="0.6" android:valueTo="1" android:valueType="floatType" android:duration="600" android:startOffset="400" android:interpolator="@interpolator/mm_standard"/>
                <objectAnimator android:propertyName="scaleY" android:valueFrom="0.6" android:valueTo="1" android:valueType="floatType" android:duration="600" android:startOffset="400" android:interpolator="@interpolator/mm_standard"/>
            </set>
        </aapt:attr>
    </target>
    <target android:name="play_fill">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="fillAlpha" android:valueFrom="0" android:valueTo="1" android:valueType="floatType" android:duration="600" android:startOffset="400" android:interpolator="@interpolator/mm_standard"/>
        </aapt:attr>
    </target>
</animated-vector>
