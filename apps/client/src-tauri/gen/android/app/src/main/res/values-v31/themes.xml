<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Android 12+ (design_handoff_splash): animated logo 4d (1000 ms) on
         #101820, "Miarina Media" / "MIARINA" branding (Manrope, rendered to
         splash_branding.png per density) at the bottom. -->
    <style name="Theme.miarina_media.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/mm_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_animated</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/splash_branding</item>
        <item name="postSplashScreenTheme">@style/Theme.miarina_media</item>
    </style>
</resources>
