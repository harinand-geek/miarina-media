<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.miarina_media" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- App background behind the system bars (design: bg #101820). -->
        <item name="android:windowBackground">@color/mm_bg</item>
    </style>
    <!-- Android 7 to 11: AndroidX SplashScreen compat, static logo 4d, no
         branding (design_handoff_splash). Android 12+ in values-v31. -->
    <style name="Theme.miarina_media.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/mm_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.miarina_media</item>
    </style>
</resources>
