<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 7 to 11: AndroidX SplashScreen compat, static logo 4d, no
         branding (design_handoff_splash). Android 12+ in values-v31. Dark
         everywhere: no light flash before the dark interface. -->
    <style name="LaunchTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/mm_window</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/NormalTheme</item>
    </style>
    <!-- Behind the Flutter UI while it initialises and runs. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/mm_window</item>
    </style>
</resources>
