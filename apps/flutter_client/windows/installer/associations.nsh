; "Ouvrir avec Miarina Media" for music and videos, the entry in Settings >
; Default apps, and the file icons of piste C (owner's choice 2026-11-21).
; Never a forced default: Windows 10/11 let the user choose (UserChoice is
; never written); a file shows the Miarina Media icon once the user picked it.
; Per user (SHCTX = HKCU for this installer). Types: ${BUNDLEID}.audio/.video.

LangString MiarinaAudioFile 1036 "Fichier audio Miarina Media"
LangString MiarinaAudioFile 1033 "Miarina Media audio file"
LangString MiarinaVideoFile 1036 "Fichier vidéo Miarina Media"
LangString MiarinaVideoFile 1033 "Miarina Media video file"
LangString MiarinaAppDescription 1036 "Lecteur et bibliothèque de musique et de vidéos"
LangString MiarinaAppDescription 1033 "Music and video player and library"

!define MM_CLASSES "Software\Classes"
!define MM_APPLICATION "${MM_CLASSES}\Applications\${MAINBINARYNAME}.exe"
!define MM_CAPABILITIES "${MANUPRODUCTKEY}\Capabilities"

!macro MiarinaRegisterFileTypes
  ; The two file types, with their icon and how to open them.
  WriteRegStr SHCTX "${MM_CLASSES}\${BUNDLEID}.audio" "" "$(MiarinaAudioFile)"
  WriteRegStr SHCTX "${MM_CLASSES}\${BUNDLEID}.audio\DefaultIcon" "" "$INSTDIR\file-audio.ico"
  WriteRegStr SHCTX "${MM_CLASSES}\${BUNDLEID}.audio\shell\open\command" "" '"$INSTDIR\${MAINBINARYNAME}.exe" "%1"'
  WriteRegStr SHCTX "${MM_CLASSES}\${BUNDLEID}.video" "" "$(MiarinaVideoFile)"
  WriteRegStr SHCTX "${MM_CLASSES}\${BUNDLEID}.video\DefaultIcon" "" "$INSTDIR\file-video.ico"
  WriteRegStr SHCTX "${MM_CLASSES}\${BUNDLEID}.video\shell\open\command" "" '"$INSTDIR\${MAINBINARYNAME}.exe" "%1"'
  ; The application itself ("Ouvrir avec", its name and icon).
  WriteRegStr SHCTX "${MM_APPLICATION}" "FriendlyAppName" "${PRODUCTNAME}"
  WriteRegStr SHCTX "${MM_APPLICATION}\DefaultIcon" "" "$INSTDIR\${MAINBINARYNAME}.exe,0"
  WriteRegStr SHCTX "${MM_APPLICATION}\shell\open\command" "" '"$INSTDIR\${MAINBINARYNAME}.exe" "%1"'
  ; Settings > Default apps > Miarina Media.
  WriteRegStr SHCTX "${MM_CAPABILITIES}" "ApplicationName" "${PRODUCTNAME}"
  WriteRegStr SHCTX "${MM_CAPABILITIES}" "ApplicationDescription" "$(MiarinaAppDescription)"
  WriteRegStr SHCTX "${MM_CAPABILITIES}" "ApplicationIcon" "$INSTDIR\${MAINBINARYNAME}.exe,0"
  WriteRegStr SHCTX "Software\RegisteredApplications" "${PRODUCTNAME}" "${MM_CAPABILITIES}"
  ; audio
  WriteRegStr SHCTX "${MM_CLASSES}\.mp3\OpenWithProgids" "${BUNDLEID}.audio" ""
  WriteRegStr SHCTX "${MM_APPLICATION}\SupportedTypes" ".mp3" ""
  WriteRegStr SHCTX "${MM_CAPABILITIES}\FileAssociations" ".mp3" "${BUNDLEID}.audio"
  WriteRegStr SHCTX "${MM_CLASSES}\.m4a\OpenWithProgids" "${BUNDLEID}.audio" ""
  WriteRegStr SHCTX "${MM_APPLICATION}\SupportedTypes" ".m4a" ""
  WriteRegStr SHCTX "${MM_CAPABILITIES}\FileAssociations" ".m4a" "${BUNDLEID}.audio"
  WriteRegStr SHCTX "${MM_CLASSES}\.flac\OpenWithProgids" "${BUNDLEID}.audio" ""
  WriteRegStr SHCTX "${MM_APPLICATION}\SupportedTypes" ".flac" ""
  WriteRegStr SHCTX "${MM_CAPABILITIES}\FileAssociations" ".flac" "${BUNDLEID}.audio"
  WriteRegStr SHCTX "${MM_CLASSES}\.ogg\OpenWithProgids" "${BUNDLEID}.audio" ""
  WriteRegStr SHCTX "${MM_APPLICATION}\SupportedTypes" ".ogg" ""
  WriteRegStr SHCTX "${MM_CAPABILITIES}\FileAssociations" ".ogg" "${BUNDLEID}.audio"
  WriteRegStr SHCTX "${MM_CLASSES}\.oga\OpenWithProgids" "${BUNDLEID}.audio" ""
  WriteRegStr SHCTX "${MM_APPLICATION}\SupportedTypes" ".oga" ""
  WriteRegStr SHCTX "${MM_CAPABILITIES}\FileAssociations" ".oga" "${BUNDLEID}.audio"
  WriteRegStr SHCTX "${MM_CLASSES}\.opus\OpenWithProgids" "${BUNDLEID}.audio" ""
  WriteRegStr SHCTX "${MM_APPLICATION}\SupportedTypes" ".opus" ""
  WriteRegStr SHCTX "${MM_CAPABILITIES}\FileAssociations" ".opus" "${BUNDLEID}.audio"
  WriteRegStr SHCTX "${MM_CLASSES}\.wav\OpenWithProgids" "${BUNDLEID}.audio" ""
  WriteRegStr SHCTX "${MM_APPLICATION}\SupportedTypes" ".wav" ""
  WriteRegStr SHCTX "${MM_CAPABILITIES}\FileAssociations" ".wav" "${BUNDLEID}.audio"
  WriteRegStr SHCTX "${MM_CLASSES}\.aac\OpenWithProgids" "${BUNDLEID}.audio" ""
  WriteRegStr SHCTX "${MM_APPLICATION}\SupportedTypes" ".aac" ""
  WriteRegStr SHCTX "${MM_CAPABILITIES}\FileAssociations" ".aac" "${BUNDLEID}.audio"
  WriteRegStr SHCTX "${MM_CLASSES}\.weba\OpenWithProgids" "${BUNDLEID}.audio" ""
  WriteRegStr SHCTX "${MM_APPLICATION}\SupportedTypes" ".weba" ""
  WriteRegStr SHCTX "${MM_CAPABILITIES}\FileAssociations" ".weba" "${BUNDLEID}.audio"
  WriteRegStr SHCTX "${MM_CLASSES}\.wma\OpenWithProgids" "${BUNDLEID}.audio" ""
  WriteRegStr SHCTX "${MM_APPLICATION}\SupportedTypes" ".wma" ""
  WriteRegStr SHCTX "${MM_CAPABILITIES}\FileAssociations" ".wma" "${BUNDLEID}.audio"
  WriteRegStr SHCTX "${MM_CLASSES}\.aif\OpenWithProgids" "${BUNDLEID}.audio" ""
  WriteRegStr SHCTX "${MM_APPLICATION}\SupportedTypes" ".aif" ""
  WriteRegStr SHCTX "${MM_CAPABILITIES}\FileAssociations" ".aif" "${BUNDLEID}.audio"
  WriteRegStr SHCTX "${MM_CLASSES}\.aiff\OpenWithProgids" "${BUNDLEID}.audio" ""
  WriteRegStr SHCTX "${MM_APPLICATION}\SupportedTypes" ".aiff" ""
  WriteRegStr SHCTX "${MM_CAPABILITIES}\FileAssociations" ".aiff" "${BUNDLEID}.audio"
  WriteRegStr SHCTX "${MM_CLASSES}\.mka\OpenWithProgids" "${BUNDLEID}.audio" ""
  WriteRegStr SHCTX "${MM_APPLICATION}\SupportedTypes" ".mka" ""
  WriteRegStr SHCTX "${MM_CAPABILITIES}\FileAssociations" ".mka" "${BUNDLEID}.audio"
  ; video
  WriteRegStr SHCTX "${MM_CLASSES}\.mp4\OpenWithProgids" "${BUNDLEID}.video" ""
  WriteRegStr SHCTX "${MM_APPLICATION}\SupportedTypes" ".mp4" ""
  WriteRegStr SHCTX "${MM_CAPABILITIES}\FileAssociations" ".mp4" "${BUNDLEID}.video"
  WriteRegStr SHCTX "${MM_CLASSES}\.m4v\OpenWithProgids" "${BUNDLEID}.video" ""
  WriteRegStr SHCTX "${MM_APPLICATION}\SupportedTypes" ".m4v" ""
  WriteRegStr SHCTX "${MM_CAPABILITIES}\FileAssociations" ".m4v" "${BUNDLEID}.video"
  WriteRegStr SHCTX "${MM_CLASSES}\.webm\OpenWithProgids" "${BUNDLEID}.video" ""
  WriteRegStr SHCTX "${MM_APPLICATION}\SupportedTypes" ".webm" ""
  WriteRegStr SHCTX "${MM_CAPABILITIES}\FileAssociations" ".webm" "${BUNDLEID}.video"
  WriteRegStr SHCTX "${MM_CLASSES}\.mkv\OpenWithProgids" "${BUNDLEID}.video" ""
  WriteRegStr SHCTX "${MM_APPLICATION}\SupportedTypes" ".mkv" ""
  WriteRegStr SHCTX "${MM_CAPABILITIES}\FileAssociations" ".mkv" "${BUNDLEID}.video"
  WriteRegStr SHCTX "${MM_CLASSES}\.mov\OpenWithProgids" "${BUNDLEID}.video" ""
  WriteRegStr SHCTX "${MM_APPLICATION}\SupportedTypes" ".mov" ""
  WriteRegStr SHCTX "${MM_CAPABILITIES}\FileAssociations" ".mov" "${BUNDLEID}.video"
  WriteRegStr SHCTX "${MM_CLASSES}\.avi\OpenWithProgids" "${BUNDLEID}.video" ""
  WriteRegStr SHCTX "${MM_APPLICATION}\SupportedTypes" ".avi" ""
  WriteRegStr SHCTX "${MM_CAPABILITIES}\FileAssociations" ".avi" "${BUNDLEID}.video"
  WriteRegStr SHCTX "${MM_CLASSES}\.ogv\OpenWithProgids" "${BUNDLEID}.video" ""
  WriteRegStr SHCTX "${MM_APPLICATION}\SupportedTypes" ".ogv" ""
  WriteRegStr SHCTX "${MM_CAPABILITIES}\FileAssociations" ".ogv" "${BUNDLEID}.video"
  WriteRegStr SHCTX "${MM_CLASSES}\.wmv\OpenWithProgids" "${BUNDLEID}.video" ""
  WriteRegStr SHCTX "${MM_APPLICATION}\SupportedTypes" ".wmv" ""
  WriteRegStr SHCTX "${MM_CAPABILITIES}\FileAssociations" ".wmv" "${BUNDLEID}.video"
  WriteRegStr SHCTX "${MM_CLASSES}\.ts\OpenWithProgids" "${BUNDLEID}.video" ""
  WriteRegStr SHCTX "${MM_APPLICATION}\SupportedTypes" ".ts" ""
  WriteRegStr SHCTX "${MM_CAPABILITIES}\FileAssociations" ".ts" "${BUNDLEID}.video"
  WriteRegStr SHCTX "${MM_CLASSES}\.m2ts\OpenWithProgids" "${BUNDLEID}.video" ""
  WriteRegStr SHCTX "${MM_APPLICATION}\SupportedTypes" ".m2ts" ""
  WriteRegStr SHCTX "${MM_CAPABILITIES}\FileAssociations" ".m2ts" "${BUNDLEID}.video"
  WriteRegStr SHCTX "${MM_CLASSES}\.mpg\OpenWithProgids" "${BUNDLEID}.video" ""
  WriteRegStr SHCTX "${MM_APPLICATION}\SupportedTypes" ".mpg" ""
  WriteRegStr SHCTX "${MM_CAPABILITIES}\FileAssociations" ".mpg" "${BUNDLEID}.video"
  WriteRegStr SHCTX "${MM_CLASSES}\.mpeg\OpenWithProgids" "${BUNDLEID}.video" ""
  WriteRegStr SHCTX "${MM_APPLICATION}\SupportedTypes" ".mpeg" ""
  WriteRegStr SHCTX "${MM_CAPABILITIES}\FileAssociations" ".mpeg" "${BUNDLEID}.video"
  WriteRegStr SHCTX "${MM_CLASSES}\.3gp\OpenWithProgids" "${BUNDLEID}.video" ""
  WriteRegStr SHCTX "${MM_APPLICATION}\SupportedTypes" ".3gp" ""
  WriteRegStr SHCTX "${MM_CAPABILITIES}\FileAssociations" ".3gp" "${BUNDLEID}.video"
  ; Explorer refreshes its icons and "Open with" lists (SHCNE_ASSOCCHANGED).
  System::Call 'shell32::SHChangeNotify(i 0x08000000, i 0, p 0, p 0)'
!macroend

!macro MiarinaUnregisterFileTypes
  ; Only what the installer wrote: the user's other apps and choices stay.
  DeleteRegValue SHCTX "${MM_CLASSES}\.mp3\OpenWithProgids" "${BUNDLEID}.audio"
  DeleteRegValue SHCTX "${MM_CLASSES}\.m4a\OpenWithProgids" "${BUNDLEID}.audio"
  DeleteRegValue SHCTX "${MM_CLASSES}\.flac\OpenWithProgids" "${BUNDLEID}.audio"
  DeleteRegValue SHCTX "${MM_CLASSES}\.ogg\OpenWithProgids" "${BUNDLEID}.audio"
  DeleteRegValue SHCTX "${MM_CLASSES}\.oga\OpenWithProgids" "${BUNDLEID}.audio"
  DeleteRegValue SHCTX "${MM_CLASSES}\.opus\OpenWithProgids" "${BUNDLEID}.audio"
  DeleteRegValue SHCTX "${MM_CLASSES}\.wav\OpenWithProgids" "${BUNDLEID}.audio"
  DeleteRegValue SHCTX "${MM_CLASSES}\.aac\OpenWithProgids" "${BUNDLEID}.audio"
  DeleteRegValue SHCTX "${MM_CLASSES}\.weba\OpenWithProgids" "${BUNDLEID}.audio"
  DeleteRegValue SHCTX "${MM_CLASSES}\.wma\OpenWithProgids" "${BUNDLEID}.audio"
  DeleteRegValue SHCTX "${MM_CLASSES}\.aif\OpenWithProgids" "${BUNDLEID}.audio"
  DeleteRegValue SHCTX "${MM_CLASSES}\.aiff\OpenWithProgids" "${BUNDLEID}.audio"
  DeleteRegValue SHCTX "${MM_CLASSES}\.mka\OpenWithProgids" "${BUNDLEID}.audio"
  DeleteRegValue SHCTX "${MM_CLASSES}\.mp4\OpenWithProgids" "${BUNDLEID}.video"
  DeleteRegValue SHCTX "${MM_CLASSES}\.m4v\OpenWithProgids" "${BUNDLEID}.video"
  DeleteRegValue SHCTX "${MM_CLASSES}\.webm\OpenWithProgids" "${BUNDLEID}.video"
  DeleteRegValue SHCTX "${MM_CLASSES}\.mkv\OpenWithProgids" "${BUNDLEID}.video"
  DeleteRegValue SHCTX "${MM_CLASSES}\.mov\OpenWithProgids" "${BUNDLEID}.video"
  DeleteRegValue SHCTX "${MM_CLASSES}\.avi\OpenWithProgids" "${BUNDLEID}.video"
  DeleteRegValue SHCTX "${MM_CLASSES}\.ogv\OpenWithProgids" "${BUNDLEID}.video"
  DeleteRegValue SHCTX "${MM_CLASSES}\.wmv\OpenWithProgids" "${BUNDLEID}.video"
  DeleteRegValue SHCTX "${MM_CLASSES}\.ts\OpenWithProgids" "${BUNDLEID}.video"
  DeleteRegValue SHCTX "${MM_CLASSES}\.m2ts\OpenWithProgids" "${BUNDLEID}.video"
  DeleteRegValue SHCTX "${MM_CLASSES}\.mpg\OpenWithProgids" "${BUNDLEID}.video"
  DeleteRegValue SHCTX "${MM_CLASSES}\.mpeg\OpenWithProgids" "${BUNDLEID}.video"
  DeleteRegValue SHCTX "${MM_CLASSES}\.3gp\OpenWithProgids" "${BUNDLEID}.video"
  DeleteRegKey SHCTX "${MM_CLASSES}\${BUNDLEID}.audio"
  DeleteRegKey SHCTX "${MM_CLASSES}\${BUNDLEID}.video"
  DeleteRegKey SHCTX "${MM_APPLICATION}"
  DeleteRegKey SHCTX "${MM_CAPABILITIES}"
  DeleteRegValue SHCTX "Software\RegisteredApplications" "${PRODUCTNAME}"
  System::Call 'shell32::SHChangeNotify(i 0x08000000, i 0, p 0, p 0)'
!macroend
