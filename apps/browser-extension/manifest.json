{
  "manifest_version": 3,
  "name": "Miarina Media",
  "version": "0.1.0",
  "description": "Send a page, video or link to your local Miarina Media inbox.",
  "permissions": ["nativeMessaging", "contextMenus", "activeTab", "storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Send to Miarina Media" }
}
